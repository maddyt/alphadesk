# ---- Supabase (required) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose

# ---- Market data provider (required for ingestion) ----
# provider: fmp | daloopa
DATA_PROVIDER=fmp
FMP_API_KEY=your-fmp-key
FMP_BASE_URL=https://financialmodelingprep.com/api/v3

# Daloopa (optional; requires an authorised Daloopa MCP/API credential)
DALOOPA_API_KEY=
DALOOPA_BASE_URL=https://mcp.daloopa.com/server/mcp

# ---- Ingestion controls ----
INGEST_UNIVERSE=AAPL,MSFT,JPM,XOM,COHR   # comma list, or SP500 to pull the index constituents
INGEST_YEARS=10
CRON_SECRET=generate-a-long-random-string

# ---- Model defaults (overridable per scenario in the UI) ----
DEFAULT_RISK_FREE=0.046
DEFAULT_ERP=0.0446
DEFAULT_TERMINAL_GROWTH=0.025
