# ---- SEC EDGAR (required for live data) ----
# SEC fair-access policy: identify yourself with a name and contact email.
SEC_USER_AGENT="ValuationEngine AI your-name@example.com"

# ---- Data mode ----
# live (default): SEC EDGAR + market data, falling back to the bundled snapshot on failure.
# snapshot: never touch the network; only the six demo tickers work.
DATA_MODE=live

# ---- Market data (optional) ----
# Without a key, prices come from the public Yahoo Finance chart API.
FMP_API_KEY=

# ---- Claude (optional) ----
# Enables the AI memos, golden-parachute extraction and the AI Deal Room.
# Without it the memos use a deterministic template and the Deal Room explains how to add it.
ANTHROPIC_API_KEY=

# ---- Supabase (recommended) ----
# Run supabase/setup.sql once in the Supabase SQL editor, then check /status.
# Gives: shared caches, saved deals, AI Deal Room history + share links, filing-text cache,
# AI spend log + budget guard, MCP call log. Use the secret (service_role) key, never in the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI spend guard (optional) ----
# Stop Claude calls for the day once this much is spent (USD, UTC day). 0 = off.
AI_DAILY_BUDGET_USD=25
# Fresh AI Deal Room runs per visitor per day. 0 = off.
AI_ROOM_RUNS_PER_IP_PER_DAY=10
